{
  // The only scheduler for timed workflows (see index.mjs). Change the ingest interval
  // with `make ingest-every HOURS=1` (demos) or `HOURS=24` (default).
  "name": "winfin-ingest-cron",
  "main": "index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "INGEST_EVERY_HOURS": "24" }
}

# WorldFin API image — multi-stage, non-root, slim.
# The build stage installs the locked server environment with uv; the runtime stage
# copies only the venv + app, so uv and its cache never ship.
FROM python:3.14-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group server

FROM python:3.14-slim
# pip is not needed at runtime and vendors old msgpack and setuptools; OpenSSL is
# patched from Debian because the base image lags its fixes.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=build /opt/venv /opt/venv

# Non-root runtime user (uid fixed so volume perms are predictable).
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY server/ ./server/
COPY worker/ ./worker/
COPY finscrape/ ./finscrape/
USER app

EXPOSE 8000
CMD ["python", "-m", "server.main"]

{
  "title": "FinScrape — Observability",
  "uid": "worldfin-obs",
  "tags": ["worldfin"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Ingest rate (events/s by source)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(worldfin_events_ingested_total[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM latency p95 (s) by backend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(worldfin_llm_request_seconds_bucket[5m])))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Source age (s since last fetch)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "worldfin_source_age_seconds",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sources up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(worldfin_source_up)" }
      ]
    },
    {
      "id": 5,
      "title": "WS clients",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "worldfin_ws_clients" }
      ]
    },
    {
      "id": 6,
      "title": "HTTP request rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(worldfin_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".*api.*|.*worker.*\"}"
        }
      ]
    }
  ]
}

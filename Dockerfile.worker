# FinScrape ingestion worker — multi-stage, non-root (Phase 10).
# Same locked environment as the api image: every dependency ships a cp314 wheel
# with its native libs bundled, so neither stage needs compilers or system libxml2.
FROM python:3.14-slim@sha256:22eafb370920ad8b429e0aec3fff433e0669968519f5d60469d83729c138b28b AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group server
# The spaCy model is not baked in: FinancialNLP loads it lazily and falls back to
# keyword extraction when it is absent.

FROM python:3.14-slim@sha256:22eafb370920ad8b429e0aec3fff433e0669968519f5d60469d83729c138b28b
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=build /opt/venv /opt/venv

RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY finscrape/ ./finscrape/
COPY server/ ./server/
COPY worker/ ./worker/
USER app

EXPOSE 9100
CMD ["python", "-m", "worker.main"]

# Base images are pinned by digest as well as tag: a tag can be re-pushed, so a rebuild
# that silently picks up a different image is indistinguishable from a clean one. Dependabot
# bumps these (plan M2.4) and the digest in the diff is the review.

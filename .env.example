# ── AI Backend ── local Ollama (default) ──────────────────────────────────
# Install Ollama: https://ollama.com
# Then: ollama pull qwen2.5:7b
#
# RAM guide:  qwen2.5:3b = ~3 GB  |  qwen2.5:7b = ~6 GB  |  qwen2.5:14b = ~10 GB
# CPU speed:  qwen2.5:7b ≈ 3-5 tok/s on CPU, 35+ tok/s on RTX 3060
#
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
FINSCRAPE_MODEL=qwen2.5:7b
FINSCRAPE_AI_TIMEOUT=180
FINSCRAPE_AI_TEMP=0.1

# ── AI Backend ── cloud fallback (OpenRouter) ──────────────────────────────
# Comment out the Ollama block above and uncomment below to use cloud APIs.
# Get a key at https://openrouter.ai
#
# OPENROUTER_API_KEY=your_key_here
# FINSCRAPE_MODEL=deepseek/deepseek-chat
# FINSCRAPE_AI_TIMEOUT=60

# ── Dashboard ──────────────────────────────────────────────────────────────
# Local dashboard (wrangler dev): http://localhost:8787
# Production dashboard: your deployed Cloudflare Workers URL
#
FINSCRAPE_DASHBOARD_URL=http://localhost:8787
FINSCRAPE_API_KEY=local-dev-key

# ── Pipeline tuning ────────────────────────────────────────────────────────
# FINSCRAPE_MAX_ARTICLES=10       # Max articles per source per run
# FINSCRAPE_MAX_AGE_HOURS=24.0    # Skip articles older than this
# FINSCRAPE_INVEST_THRESHOLD=3    # Score >= 3 → INVEST verdict
# FINSCRAPE_DEDUP_SIMILARITY=0.85 # Headline dedup similarity threshold
# FINSCRAPE_CACHE_TTL=3600        # AI response cache TTL in seconds
# FINSCRAPE_CACHE_MAX_SIZE=500    # Max cached responses

# ── Optional integrations ──────────────────────────────────────────────────
# SERPER_API_KEY=     # Google SERP news (rate-limited, optional)
# RELIEFWEB_APPNAME=  # approved ReliefWeb v2 appname; the source is off without it

# ── WorldFin backend (server/) ─────────────────────────────────────────────
# Compose injects WORLDFIN_DATABASE_URL for the api container; this default is
# for running the api on the host against a native Postgres on 5432. The compose
# Postgres publishes on 5433 so the two never fight over one port.
WORLDFIN_DATABASE_URL=postgresql://worldfin:worldfin@localhost:5432/worldfin
# Host ports the compose stack publishes; defaults avoid 8000/5432/6379/3000,
# which other local stacks commonly hold.
# WORLDFIN_API_HOST_PORT=8010
# WORLDFIN_PG_HOST_PORT=5433
# WORLDFIN_REDIS_HOST_PORT=6380
# GRAFANA_HOST_PORT=3002
# WORLDFIN_DB_POOL_MIN=2
# WORLDFIN_DB_POOL_MAX=10
# WORLDFIN_RUN_MIGRATIONS=true     # apply server/migrations/*.sql on startup
# WORLDFIN_HOST=0.0.0.0
# WORLDFIN_PORT=8010
# WORLDFIN_CORS_ORIGINS=*          # comma-separated allowlist
# WORLDFIN_ENV=production          # refuse to start with the default key or CORS *
# WORLDFIN_REDIS_URL=redis://localhost:6379/0   # enables cache + WS fan-out
# WORLDFIN_ENABLE_COUNCIL=false    # multi-agent explainability (Phase 7)
# WORLDFIN_ENABLE_CORRELATION=true # correlation engine (Phase 4)
#
# ── Hardening (Phase 8) ──
# WORLDFIN_RATE_LIMIT_PER_MIN=120  # per-IP sliding-window limit; 0 disables
# WORLDFIN_ENABLE_HSTS=false       # set true only when served over TLS
# WORLDFIN_ENABLE_ETAG=true        # weak ETag + 304 on GET JSON
#
# ── Observability (Phase 9) ──
# WORLDFIN_LOG_JSON=false          # one-line JSON logs (compose sets true for Loki)
# WORLDFIN_LOG_LEVEL=INFO
# WORLDFIN_METRICS_PORT=9100       # worker Prometheus /metrics port (0 disables)
# GRAFANA_USER=admin               # docker-compose.obs.yml only
# GRAFANA_PASSWORD=admin
#
# ── Telegram (Phase 13) ──
# TELEGRAM_BOT_TOKEN=              # outbound INVEST/PULL_OUT alerts
# TELEGRAM_WEBHOOK_SECRET=         # required for inbound bot commands. The webhook URL
#                                  # is public and its body is attacker-written, so
#                                  # /api/telegram/webhook ignores every update until
#                                  # this is set. Pass the same value to
#                                  # setWebhook(secret_token=...).
#
# FINSCRAPE_MODEL must name a real model on your backend — the "auto" default is a
# placeholder no backend resolves, so AI analysis 404s and silently returns the
# heuristic. List the ids with: curl $OPENAI_BASE_URL/models
# OPENAI_API_KEY is the bearer for OPENAI_BASE_URL (local Ollama ignores it; any
# hosted OpenAI-compatible endpoint rejects the call without it).
#
# FINSCRAPE_API_KEY (above) authenticates the mutating /api routes: POST /api/events,
# the four portfolio/watchlist routes, and the two /api/v1 signal-ingest routes.
# LLM backend reuses OPENAI_BASE_URL / OPENROUTER_API_KEY / FINSCRAPE_MODEL above.
